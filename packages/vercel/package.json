{
  "name": "@agentghost/vercel",
  "version": "0.1.1",
  "description": "AgentGhost guard for the Vercel AI SDK. Wrap AI SDK tools with intent-aware ALLOW / ASK / DENY authorization.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "AgentGhost contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reddpy/AgentGhost.git",
    "directory": "packages/vercel"
  },
  "homepage": "https://github.com/reddpy/AgentGhost#readme",
  "bugs": {
    "url": "https://github.com/reddpy/AgentGhost/issues"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node ../../scripts/write-cjs-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "bun run build && bun run build:cjs"
  },
  "keywords": [
    "ai",
    "agents",
    "tools",
    "authorization",
    "guard",
    "vercel",
    "ai-sdk"
  ],
  "dependencies": {
    "@agentghost/sdk": "^0.1.1"
  },
  "peerDependencies": {
    "ai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  }
}
